{
  "name": "obsidian-live-image-editor",
  "version": "0.4.0",
  "description": "Non-destructive image editing for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "OBSIDIAN_PLUGIN_DIR=examples/.obsidian/plugins/live-image-editor node esbuild.config.mjs",
    "check:watch": "tsc -noEmit --watch --preserveWatchOutput",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "build:dev": "node esbuild.config.mjs dev",
    "debug:obsidian": "node scripts/obsidian-debug.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "version": "node version-bump.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.1"
  }
}
