node_modules/
main.js
/lie-runtime.js
*.js.map
.devcontainer/.env
**.DS_Store

# Local dev scratch — handoff/working prompts, deleted once the work is handled.
prompts/

# Obsidian per-vault local state (regenerated on open) — keep the committed debug
# config (plugins/snippets/app.json) but not the per-machine layout/settings.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
example-vault/.obsidian/plugins/live-image-editor/data.json
# regenerated build artifact (npm run build / dev:vault writes it) — like main.js, don't track
example-vault/.obsidian/plugins/live-image-editor/styles.css

# MkDocs site build (docs/ -> GitHub Pages)
/site/
.venv-docs/
__pycache__/
# generated example pages + images (scripts/mkdocs_hooks.py copies them from example-vault/);
# the committed README.md landing page is kept.
docs/examples/*
!docs/examples/README.md
# copied from the build artifact in CI / local preview
docs/assets/lie-runtime.js
example-vault/_dev-tools/dev-diagnostics/diagnostics-log.md
