{
  "name": "Live Image Editor",
  "dockerFile": "DockerFile",
  "mounts": [
		"source=${devcontainerId}-claude,target=/home/${localEnv:USER}/.claude,type=volume"
	],
  "initializeCommand": "./scripts/prebuild.sh",
  "containerUser": "${localEnv:USER}",
  "remoteUser": "${localEnv:USER}",
  "postCreateCommand": "sudo chown -R \"$(id -u)\":\"$(id -g)\" \"$HOME/.claude\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Anthropic.claude-code",
        "vitest.explorer",
        "ms-vscode.js-debug",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
