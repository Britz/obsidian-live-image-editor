{
  "name": "Live Image Editor",
  "dockerFile": "DockerFile",
  "mounts": [
		"source=${devcontainerId}-claude,target=/home/${localEnv:USER}/.claude,type=volume"
	],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "./.devcontainer/prebuild.sh",
  "containerUser": "${localEnv:USER}",
  "remoteUser": "${localEnv:USER}",
  "postCreateCommand": "sudo chown -R \"$(id -u)\":\"$(id -g)\" \"$HOME/.claude\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Anthropic.claude-code",
        "vitest.explorer",
        "ms-vscode.js-debug",
        "ms-python.python",
        "ms-python.debugpy",
        "EditorConfig.EditorConfig",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens",
        "ms-vscode.live-server"
      ]
    }
  }
}
